import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import fsp from "node:fs/promises";
import os from "node:os";
import path from "node:path";

export const TOPIC_BRANCH = "agent/workflow-core";

export function git(cwd, ...args) {
  const result = spawnSync("git", args, {
    cwd,
    encoding: "utf8",
    // The identity rides in the environment, not in the repository's local
    // config: a test may unset that config (the container launcher refuses
    // a checkout whose config holds more than a fresh clone writes), and a
    // runner without a domain name cannot guess one.
    env: {
      ...process.env,
      GIT_CONFIG_GLOBAL: "/dev/null",
      GIT_AUTHOR_NAME: "Review Bridge Test",
      GIT_AUTHOR_EMAIL: "review-bridge@example.invalid",
      GIT_COMMITTER_NAME: "Review Bridge Test",
      GIT_COMMITTER_EMAIL: "review-bridge@example.invalid",
    },
  });
  assert.equal(result.status, 0, result.stderr);
  return result.stdout.trim();
}

// objectFormat names the repository's Git object format when the caller needs
// a specific one: a sha256 repository names its commits with 64 hex characters
// instead of 40, which is the one difference the local guards have to survive.
// Left unset, `git init` decides, so a caller that sets GIT_DEFAULT_HASH still
// gets the format it asked the environment for.
export async function fixture({ objectFormat = null } = {}) {
  const root = await fsp.mkdtemp(
    path.join(os.tmpdir(), "review-bridge-remote-"),
  );
  const repository = path.join(root, "repo");
  const store = path.join(root, "store");
  await fsp.mkdir(repository);
  git(
    repository,
    "init",
    "-b",
    "main",
    ...(objectFormat == null ? [] : [`--object-format=${objectFormat}`]),
  );
  git(repository, "config", "user.name", "Review Bridge Test");
  git(repository, "config", "user.email", "review-bridge@example.invalid");
  await fsp.writeFile(
    path.join(repository, "app.js"),
    "export const value = 1;\n",
  );
  git(repository, "add", ".");
  git(repository, "commit", "-m", "base");
  git(
    repository,
    "remote",
    "add",
    "origin",
    "ssh://git@github.com/example/review-bridge.git",
  );
  const baseSha = git(repository, "rev-parse", "HEAD");
  git(repository, "switch", "-c", TOPIC_BRANCH);
  return { root, repository, store, baseSha };
}

export async function commit(repository, content) {
  await fsp.writeFile(path.join(repository, "app.js"), content);
  git(repository, "add", ".");
  git(repository, "commit", "-m", "change");
  return git(repository, "rev-parse", "HEAD");
}
